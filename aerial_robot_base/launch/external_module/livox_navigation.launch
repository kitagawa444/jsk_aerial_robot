<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="robot_ns" default="quadrotor" />
  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">
    <!-- Scan conversion is provided by the shared Livox sensor launch. -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/base_local_planner_default_params.yaml" command="load" />
      <rosparam file="$(find aerial_robot_base)/config/navigation/livox/move_base_params.yaml" command="load" />
      <param name="global_costmap/obstacle_layer/scan/topic" value="livox/scan" />
      <param name="global_costmap/obstacle_layer/scan/min_obstacle_height" value="-0.1"  />
      <param name="local_costmap/obstacle_layer/scan/topic" value="livox/scan"  />
      <param name="local_costmap/obstacle_layer/scan/min_obstacle_height" value="-0.1"  />
      <param name="local_costmap/robot_base_frame" value="$(arg robot_ns)/root"  />
      <param name="global_costmap/robot_base_frame" value="$(arg robot_ns)/root"  />
    </node>

    <node pkg="aerial_robot_control" type="cmd_vel_to_flight_nav.py" name="cmd_vel_to_flight_nav" output="screen"/>

  </group>
</launch>
