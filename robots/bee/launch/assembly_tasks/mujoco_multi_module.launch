<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="robot_count" default="3"/>
  <!-- MuJoCo rendering and RViz visualization are independent. -->
  <arg name="headless" default="true"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="render_fps" default="10.0"/>
  <!-- <= 0 keeps unlimited headless speed; use 1.0 for online MPC. -->
  <arg name="real_time_factor" default="0.0"/>
  <arg name="vsync" default="false"/>
  <arg name="render_shadows" default="false"/>
  <arg name="render_reflections" default="false"/>
  <arg name="window_width" default="640"/>
  <arg name="window_height" default="480"/>
  <arg name="scene_camera_extent" default="1.2"/>
  <arg name="first_robot_rviz_only" default="true"/>
  <arg name="estimate_mode" default="1"/>
  <arg name="spawn_x_start" default="-2.0"/>
  <arg name="spawn_y_start" default="0.0"/>
  <!-- robot.xml starts base_link at z=0.20 m.  Offset it so the rubber-ball
       bottoms start about 1 mm above the floor instead of dropping 81 mm. -->
  <arg name="spawn_z" default="-0.08"/>
  <arg name="spacing_x" default="1.0"/>
  <arg name="spacing_y" default="1.0"/>
  <arg name="grid_cols" default="0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="grasp_staging_layout" default="true"/>
  <arg name="grasp_staging_clearance" default="0.80"/>
  <!-- Delay args remain as optional minimum waits for compatibility.  Ready
       conditions, rather than these delays, gate backend/controller startup. -->
  <!-- Give every per-Bee process time to finish controller/plugin
       initialization before the shared backend starts publishing joint
       states.  With four or more Bees, starting immediately can expose a
       first-update Eigen matrix race in aerial_robot_base_node. -->
  <arg name="backend_start_delay" default="1.0"/>
  <arg name="param_load_delay" default="3.0"/>
  <arg name="backend_ready_timeout" default="30.0"/>
  <arg name="param_load_timeout" default="30.0"/>
  <arg name="regenerate_single_model" default="false"/>
  <!-- MuJoCo soft friction otherwise creeps under sustained payload load. -->
  <arg name="contact_impratio" default="50.0"/>
  <arg name="friction_cone" default="elliptic"/>
  <arg name="constraint_solver" default="Newton"/>
  <arg name="spawn_object" default="true"/>
  <arg name="object_x" default="0.0"/>
  <arg name="object_y" default="1.0"/>
  <arg name="object_ground_clearance" default="0.0"/>
  <arg name="object_yaw" default="0.0"/>
  <arg name="object_shape" default="triangular_prism"/>
  <!-- Equal-width/equal-height EPS prism: 600 mm outer side and height. A
       concentric 418.626 mm vertical triangular hole gives exactly 0.500 kg
       at the 96-times EPS density below. Normal wall thickness is 52.36 mm. -->
  <arg name="object_height" default="0.60"/>
  <arg name="object_triangle_side" default="0.60"/>
  <arg name="object_inner_triangle_side" default="0.4186262221"/>
  <arg name="object_pentagon_side" default="0.60"/>
  <!-- Full side lengths used when object_shape:=box. -->
  <arg name="object_size_x" default="0.60"/>
  <arg name="object_size_y" default="0.60"/>
  <arg name="object_density" default="10.4166666667"/>
  <!-- Positive values override density-derived mass; <= 0 selects density. -->
  <arg name="object_mass" default="-1.0"/>
  <arg name="object_freejoint_damping" default="0.5"/>
  <arg name="object_sliding_friction" default="0.5"/>
  <arg name="object_torsional_friction" default="0.5"/>
  <arg name="pedestal_torsional_friction" default="2.0"/>
  <arg name="spawn_object_pedestal" default="true"/>
  <arg name="object_pedestal_height" default="0.65"/>
  <arg name="object_pedestal_radius" default="0.20"/>
  <arg name="spawn_destination_pedestal" default="false"/>
  <arg name="destination_pedestal_x" default="1.50"/>
  <arg name="destination_pedestal_y" default="1.00"/>
  <arg name="destination_pedestal_height" default="0.65"/>
  <arg name="destination_pedestal_radius" default="0.20"/>

  <!-- Robot bringup nodes must use simulation time from their initialization.
       The shared MuJoCo backend, which also sets this parameter, starts later. -->
  <rosparam param="/use_sim_time">true</rosparam>

  <node pkg="bee" type="mujoco_multi_bringup.py" name="bee_mujoco_multi_bringup" output="screen" required="true">
    <param name="robot_count" value="$(arg robot_count)"/>
    <param name="headless" value="$(arg headless)"/>
    <param name="launch_rviz" value="$(arg launch_rviz)"/>
    <param name="render_fps" value="$(arg render_fps)"/>
    <param name="real_time_factor" value="$(arg real_time_factor)"/>
    <param name="vsync" value="$(arg vsync)"/>
    <param name="render_shadows" value="$(arg render_shadows)"/>
    <param name="render_reflections" value="$(arg render_reflections)"/>
    <param name="window_width" value="$(arg window_width)"/>
    <param name="window_height" value="$(arg window_height)"/>
    <param name="scene_camera_extent" value="$(arg scene_camera_extent)"/>
    <param name="first_robot_rviz_only" value="$(arg first_robot_rviz_only)"/>
    <param name="estimate_mode" value="$(arg estimate_mode)"/>
    <param name="spawn_x_start" value="$(arg spawn_x_start)"/>
    <param name="spawn_y_start" value="$(arg spawn_y_start)"/>
    <param name="spawn_z" value="$(arg spawn_z)"/>
    <param name="spacing_x" value="$(arg spacing_x)"/>
    <param name="spacing_y" value="$(arg spacing_y)"/>
    <param name="grid_cols" value="$(arg grid_cols)"/>
    <param name="spawn_yaw" value="$(arg spawn_yaw)"/>
    <param name="grasp_staging_layout" value="$(arg grasp_staging_layout)"/>
    <param name="grasp_staging_clearance" value="$(arg grasp_staging_clearance)"/>
    <param name="backend_start_delay" value="$(arg backend_start_delay)"/>
    <param name="param_load_delay" value="$(arg param_load_delay)"/>
    <param name="backend_ready_timeout" value="$(arg backend_ready_timeout)"/>
    <param name="param_load_timeout" value="$(arg param_load_timeout)"/>
    <param name="regenerate_single_model" value="$(arg regenerate_single_model)"/>
    <param name="contact_impratio" value="$(arg contact_impratio)"/>
    <param name="friction_cone" value="$(arg friction_cone)"/>
    <param name="constraint_solver" value="$(arg constraint_solver)"/>
    <param name="spawn_object" value="$(arg spawn_object)"/>
    <param name="object_x" value="$(arg object_x)"/>
    <param name="object_y" value="$(arg object_y)"/>
    <param name="object_ground_clearance" value="$(arg object_ground_clearance)"/>
    <param name="object_yaw" value="$(arg object_yaw)"/>
    <param name="object_shape" value="$(arg object_shape)"/>
    <param name="object_height" value="$(arg object_height)"/>
    <param name="object_triangle_side" value="$(arg object_triangle_side)"/>
    <param name="object_inner_triangle_side" value="$(arg object_inner_triangle_side)"/>
    <param name="object_pentagon_side" value="$(arg object_pentagon_side)"/>
    <param name="object_size_x" value="$(arg object_size_x)"/>
    <param name="object_size_y" value="$(arg object_size_y)"/>
    <param name="object_density" value="$(arg object_density)"/>
    <param name="object_mass" value="$(arg object_mass)"/>
    <param name="object_freejoint_damping" value="$(arg object_freejoint_damping)"/>
    <param name="object_sliding_friction" value="$(arg object_sliding_friction)"/>
    <param name="object_torsional_friction" value="$(arg object_torsional_friction)"/>
    <param name="pedestal_torsional_friction" value="$(arg pedestal_torsional_friction)"/>
    <param name="spawn_object_pedestal" value="$(arg spawn_object_pedestal)"/>
    <param name="object_pedestal_height" value="$(arg object_pedestal_height)"/>
    <param name="object_pedestal_radius" value="$(arg object_pedestal_radius)"/>
    <param name="spawn_destination_pedestal" value="$(arg spawn_destination_pedestal)"/>
    <param name="destination_pedestal_x" value="$(arg destination_pedestal_x)"/>
    <param name="destination_pedestal_y" value="$(arg destination_pedestal_y)"/>
    <param name="destination_pedestal_height" value="$(arg destination_pedestal_height)"/>
    <param name="destination_pedestal_radius" value="$(arg destination_pedestal_radius)"/>
  </node>

  <group if="$(arg launch_rviz)">
    <node pkg="bee" type="mujoco_scene_visualizer.py"
          name="bee_mujoco_scene_visualizer" output="screen">
      <param name="robot_count" value="$(arg robot_count)"/>
      <param name="object_x" value="$(arg object_x)"/>
      <param name="object_y" value="$(arg object_y)"/>
      <param name="object_ground_clearance" value="$(arg object_ground_clearance)"/>
      <param name="object_yaw" value="$(arg object_yaw)"/>
      <param name="object_shape" value="$(arg object_shape)"/>
      <param name="object_height" value="$(arg object_height)"/>
      <param name="object_triangle_side" value="$(arg object_triangle_side)"/>
      <param name="object_inner_triangle_side" value="$(arg object_inner_triangle_side)"/>
      <param name="object_pentagon_side" value="$(arg object_pentagon_side)"/>
      <param name="object_size_x" value="$(arg object_size_x)"/>
      <param name="object_size_y" value="$(arg object_size_y)"/>
      <param name="spawn_object" value="$(arg spawn_object)"/>
      <param name="spawn_object_pedestal" value="$(arg spawn_object_pedestal)"/>
      <param name="object_pedestal_height" value="$(arg object_pedestal_height)"/>
      <param name="object_pedestal_radius" value="$(arg object_pedestal_radius)"/>
      <param name="spawn_destination_pedestal" value="$(arg spawn_destination_pedestal)"/>
      <param name="destination_pedestal_x" value="$(arg destination_pedestal_x)"/>
      <param name="destination_pedestal_y" value="$(arg destination_pedestal_y)"/>
      <param name="destination_pedestal_height" value="$(arg destination_pedestal_height)"/>
      <param name="destination_pedestal_radius" value="$(arg destination_pedestal_radius)"/>
    </node>
    <node pkg="rviz" type="rviz" name="bee_mujoco_multi_rviz"
          args="-d $(find bee)/config/mujoco_multi.rviz" output="screen"/>
  </group>
</launch>
