<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="real_machine" default="True" />
  <arg name="simulation" default="False" />
  <arg name="force_observer_profile" value="$(eval 'simulation' if arg('simulation') else 'hardware')"/>
  <arg name="force_control_config" default="$(find bee)/config/controller/force_control.yaml"/>
  <arg name="reference_tracking_config" default=""/>
  <arg name="estimate_mode"  default= "1" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world" />
  <arg name="launch_gazebo" default="True" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <!-- Keep the Gazebo rubber balls above the ground at insertion; the robot
       then settles onto roughly 6 mm of spring compression. -->
  <arg name="spawn_z" default="0.13"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="config_dir" default="$(find bee)/config"/>
  <arg name="robot_id" default="1" />
  <arg name="robot_ns" value="bee$(arg robot_id)" />
  <arg name="mujoco" default="False" />
  <arg name="lidar_sim" default="False" />
  <arg name="livox_enable" default="false"/>
  <arg name="livox_model_option" default="$(eval 'enable_livox:=true' if arg('lidar_sim') else 'enable_livox:=false')" />
  <arg name="launch_mujoco_backend" default="True" />
  <arg name="launch_mujoco_controller" default="True" />
  <arg name="mujoco_real_time_factor" default="$(eval 0.0 if arg('headless') else 1.0)"/>
  <arg name="mujoco_render_fps" default="30.0" />
  <arg name="mujoco_vsync" default="false" />
  <arg name="mujoco_render_shadows" default="false" />
  <arg name="mujoco_render_reflections" default="false" />
  <arg name="mujoco_window_width" default="960" />
  <arg name="mujoco_window_height" default="720" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">
    <param if="$(eval arg('simulation') and arg('mujoco') and arg('launch_mujoco_backend') and not arg('real_machine'))" name="mujoco_ros_control/real_time_factor" value="$(arg mujoco_real_time_factor)"/>
    <rosparam command="load" file="$(arg force_control_config)" ns="controller" subst_value="true"/>
    <rosparam if="$(eval arg('reference_tracking_config') != '')" command="load" file="$(arg reference_tracking_config)" ns="controller/reference_tracking"/>
    <param name="controller/reference_tracking/base_topic" value="$(eval 'ground_truth' if arg('mujoco') else 'uav/baselink/odom')"/>
    <param name="controller/reference_tracking/allow_empty_base_frame" value="$(arg mujoco)"/>
    <param name="controller/reference_tracking/cog_frame" value="$(arg robot_ns)/cog"/>

    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2

    ###########  Basic Param  ###########
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(arg real_machine)"/>
    <param name = "robot_id" value="$(arg robot_id)"/>
   ###########  Robot Model  ###########
   <rosparam file="$(arg config_dir)/RobotModel.yaml" command="load" />

   ###########  Motor Config  ###########
   <rosparam file="$(arg config_dir)/MotorInfo.yaml" command="load" />

   ###########  Servo Config  ###########
   <rosparam file="$(arg config_dir)/Servo.yaml" command="load"/>

   ###########  Battery Config  ###########
   <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

   ###########  Control  ###########
   <rosparam file="$(arg config_dir)/BeeControl.yaml" command="load" if="$(eval not simulation)"/>
   <rosparam file="$(arg config_dir)/BeeControl_sim.yaml" command="load" if="$(eval simulation)"/>
   <param name="controller/wrench_estimate_flag" value="true"/>
   <param name="controller/gravity_compensation" value="true"/>
   ###########  Sensor Fusion  ###########
   <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
   <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

   ###########  Navigation  ###########
   <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/bee_navigation" />
   <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />

  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen" >
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="40"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find bee)/robots/bee.$(arg description_mode).xacro"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(arg config_dir)/rviz_config" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="model_options" value="$(arg livox_model_option)" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include >

  ##########  Sensors  ##########
  <include file="$(find bee)/launch/include/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="robot_id" value="$(arg robot_id)"/>
    <arg name="livox_enable" value="$(arg livox_enable)"/>
    <arg name="lidar_sim" value="$(arg lidar_sim)"/>
    <arg name="mujoco" value="$(arg mujoco)"/>
  </include >

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge" ns="$(arg robot_ns)" output="screen">
    <param name="use_mujoco" value="true" if="$(arg mujoco)"/>
  </node>


  ########## Simulation in Gazebo #########
  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" if = "$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" value="false" if="$(arg headless)"/>
    <arg name="headless" default="$(arg headless)" />
    <arg name="launch_gazebo" default="$(arg launch_gazebo)" />
    <arg name="worldtype" value="$(arg worldtype)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>

  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(find bee)/mujoco/bee/robot.xml"/>
    <arg name="launch_backend" value="$(arg launch_mujoco_backend)"/>
    <arg name="launch_controller" value="$(arg launch_mujoco_controller)"/>
    <arg name="render_fps" value="$(arg mujoco_render_fps)"/>
    <arg name="vsync" value="$(arg mujoco_vsync)"/>
    <arg name="render_shadows" value="$(arg mujoco_render_shadows)"/>
    <arg name="render_reflections" value="$(arg mujoco_render_reflections)"/>
    <arg name="window_width" value="$(arg mujoco_window_width)"/>
    <arg name="window_height" value="$(arg mujoco_window_height)"/>
  </include>



</launch>
