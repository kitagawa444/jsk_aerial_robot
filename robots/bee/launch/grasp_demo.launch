<launch>
  <!-- Simulation-only automatic startup. Control remains in the C++ nodes. -->
  <arg name="robot_count" default="3"/>
  <arg name="headless" default="true"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="scene_config" default="$(eval find('bee') + '/config/grasp/scene_' + {3: 'triangle', 4: 'box', 5: 'pentagon'}[arg('robot_count')] + '.yaml')"/>
  <include file="$(find bee)/launch/grasp_sim.launch">
    <arg name="robot_count" value="$(arg robot_count)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="scene_config" value="$(arg scene_config)"/>
    <arg name="execute" value="true"/>
  </include>
  <group if="$(arg launch_rviz)">
    <node pkg="bee" type="mujoco_scene_visualizer.py" name="bee_mujoco_scene_visualizer" output="screen">
      <rosparam command="load" file="$(arg scene_config)"/>
      <param name="robot_count" value="$(arg robot_count)"/>
    </node>
    <node pkg="rviz" type="rviz" name="bee_mujoco_multi_rviz"
          args="-d $(find bee)/config/mujoco_multi.rviz" output="screen"/>
  </group>
  <node pkg="bee" type="grasp_sim_autostart.py" name="bee_grasp_sim_autostart" output="screen" required="true">
    <param name="robot_count" value="$(arg robot_count)"/>
  </node>
</launch>
