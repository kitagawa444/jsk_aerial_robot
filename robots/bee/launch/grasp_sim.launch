<launch>
  <!-- Simulation entry point: environment, vehicles, and central control. -->
  <arg name="robot_count" default="3"/>
  <arg name="scene_config" default="$(eval find('bee') + '/config/grasp/scene_' + {3: 'triangle', 4: 'box', 5: 'pentagon'}[arg('robot_count')] + '.yaml')"/>
  <arg name="controller_config" default="$(find bee)/config/grasp/controller.yaml"/>
  <arg name="task_config" default="$(eval find('bee') + '/config/grasp/' + ('task.yaml' if arg('robot_count') == 3 else 'task_multi.yaml'))"/>
  <arg name="interface_config" default="$(find bee)/config/grasp/interface_mujoco.yaml"/>
  <arg name="headless" default="true"/>
  <arg name="real_time_factor" default="1.0"/>
  <arg name="execute" default="false"/>
  <arg name="output_dir" default="$(find bee)/mujoco/generated"/>

  <param name="/use_sim_time" value="true"/>

  <include file="$(find bee)/launch/mujoco_world.launch">
    <arg name="robot_count" value="$(arg robot_count)"/>
    <arg name="scene_config" value="$(arg scene_config)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="real_time_factor" value="$(arg real_time_factor)"/>
    <arg name="output_dir" value="$(arg output_dir)"/>
  </include>

  <include file="$(find bee)/launch/multi_robot_bringup.launch">
    <arg name="robot_count" value="$(arg robot_count)"/>
    <arg name="controller_config" value="$(arg controller_config)"/>
  </include>

  <include file="$(find bee)/launch/cooperative_grasp.launch">
    <arg name="execute" value="$(arg execute)"/>
    <arg name="controller_config" value="$(arg controller_config)"/>
    <arg name="task_config" value="$(arg task_config)"/>
    <arg name="interface_config" value="$(arg interface_config)"/>
  </include>
</launch>
