<?xml version="1.0"?>
<launch>
  <arg name="real_machine" default="false" />
  <arg name="simulation" default="false" />
  <arg name="robot_ns" default="bee1" />
  <arg name="robot_id" default="1" />
  <arg name="livox_enable" default="false"/>
  <arg name="lidar_sim" default="false"/>
  <arg name="mujoco" default="false"/>
  <group ns="$(arg robot_ns)">

    <group if="$(arg real_machine)">
      <group unless="$(arg simulation)">
        <!-- fc & IMU & GPS -->
        <include file="$(find spinal)/launch/bridge.launch" >
          <arg name="mode" value="serial" />
          <arg name="serial_port" value="/dev/flight_controller" />
          <arg name="serial_baud" value="921600" />
        </include>
      </group>

      <!-- mocap -->
      <include file="$(find aerial_robot_base)/launch/external_module/mocap.launch">
	<arg name="robot_id" value="$(arg robot_id)"/>
      </include>
    </group>

    <!-- basic configuration for sensors (e.g. noise sigma) -->
    <rosparam file="$(find bee)/config/sensors/imu/spinal.yaml" command="load" />
    <rosparam file="$(find aerial_robot_base)/config/sensors/mocap.yaml" command="load" />
  </group>

  <include file="$(find aerial_robot_base)/launch/external_module/livox_mid360.launch"
           if="$(eval (arg('real_machine') and not arg('simulation') and arg('livox_enable')) or (arg('simulation') and not arg('real_machine') and not arg('mujoco') and arg('lidar_sim')))">
    <arg name="robot_ns" value="$(arg robot_ns)"/>
    <arg name="simulation" value="$(arg simulation)"/>
  </include>
</launch>
