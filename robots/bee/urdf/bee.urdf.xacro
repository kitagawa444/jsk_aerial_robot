<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="bee_link" >

  <xacro:property name="grasp_geometry" value="${xacro.load_yaml('$(find bee)/config/contact_point.yaml')}"/>
  <xacro:property name="foot_spacing" value="${grasp_geometry['foot_spacing']}"/>
  <xacro:property name="foot_depth" value="${grasp_geometry['foot_contact_offset']}"/>
  <xacro:macro name="bee_foot_visual" params="name x y z yaw">
    <visual name="foot_ball_${name}">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
      <geometry><mesh filename="package://bee/urdf/mesh/foot_ball.dae"/></geometry>
    </visual>
  </xacro:macro>
  <xacro:property name="body_colors" value="${xacro.load_yaml('$(find bee)/config/body_colors.yaml')}"/>
  <xacro:property name="propeller_colors" value="${body_colors['propeller']}"/>
  <xacro:property name="propeller_rgba" value="${propeller_colors.get(int('$(arg robot_id)'), propeller_colors['default'])}"/>
  <material name="propeller_color"><color rgba="${propeller_rgba}"/></material>

  <xacro:property name="separate_foot_inertia" default="${False}"/>
  <xacro:macro name="bee_center_link" params="child1 child2 child3 child4">
    ## dummy
    <link name="root">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>
    <joint name="root_joint" type="fixed">
      <parent link="root"/>
      <child link="base_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    ## link
    <link name="base_link">
      <inertial>
        <xacro:unless value="${separate_foot_inertia}">
          <mass value="1.18844686"/>
          <origin xyz="0.00167307 0.00029896 -0.00372872" rpy="0 0 0"/>
          <inertia ixx="0.00354563" ixy="-0.00006477" ixz="-0.00005943"
                   iyy="0.00368400" iyz="-0.00000043" izz="0.00454564"/>
        </xacro:unless>
        <xacro:if value="${separate_foot_inertia}">
          <!-- CAD assembly minus the four 7 g sliding feet at zero compression. -->
          <mass value="1.16044686"/>
          <origin xyz="0.0017134388972 0.00030617349705 -0.00171260369115" rpy="0 0 0"/>
          <inertia ixx="0.00328051291949" ixy="-0.00006475565701" ixz="-0.00005542124548"
                   iyy="0.00341880521474" iyz="0.00000028632224" izz="0.00441821517851"/>
        </xacro:if>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bee/urdf/mesh/base_link.dae"/>
        </geometry>
      </visual>
      <xacro:bee_foot_visual name="front" x="${foot_spacing}" y="0" z="${-foot_depth}" yaw="0"/>
      <xacro:bee_foot_visual name="rear" x="${-foot_spacing}" y="0" z="${-foot_depth}" yaw="${pi}"/>
      <xacro:bee_foot_visual name="left" x="0" y="${foot_spacing}" z="${-foot_depth}" yaw="${pi/2}"/>
      <xacro:bee_foot_visual name="right" x="0" y="${-foot_spacing}" z="${-foot_depth}" yaw="${-pi/2}"/>
      <xacro:if value="$(arg livox)">
        <visual name="livox_module">
          <geometry><mesh filename="package://bee/urdf/mesh/livox_module.dae"/></geometry>
        </visual>
      </xacro:if>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.25 0.25 0.17"/>
        </geometry>
      </collision>
    </link>

    <xacro:property name="trim_rgba" value="${body_colors.get(int('$(arg robot_id)'), body_colors['default'])}"/>
    <link name="body_trim">
      <visual>
        <geometry><mesh filename="package://bee/urdf/mesh/body_trim.stl"/></geometry>
        <material name="body_trim_color"><color rgba="${trim_rgba}"/></material>
      </visual>
    </link>
    <joint name="body_trim_joint" type="fixed">
      <parent link="base_link"/><child link="body_trim"/>
    </joint>
    <gazebo reference="body_trim">
      <visual><material><ambient>${trim_rgba}</ambient><diffuse>${trim_rgba}</diffuse></material></visual>
    </gazebo>

    <xacro:damping_factor link="base_link"/>

    <link name="fc">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>
    <joint name="fc_joint" type="fixed">
      <child link="fc"/>
      <parent link="base_link"/>
      <origin rpy="0 0 0" xyz="-0.0175 0 0.0540"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- Geometry-only frame, published by robot_state_publisher even without
         the grasp controller. No mass, collision or visual geometry. -->
    <xacro:property name="grasp_offset" value="${grasp_geometry['contact_offset']}"/>
    <link name="grasp_contact_point"/>
    <joint name="grasp_contact_point_joint" type="fixed">
      <parent link="fc"/>
      <child link="grasp_contact_point"/>
      <origin xyz="${grasp_offset[0]} ${grasp_offset[1]} ${grasp_offset[2]}" rpy="0 0 0"/>
    </joint>

    ## rotor arms
    <link name="rotor_arm${child1}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.0000001" ixy="0.0" ixz="0.0"
            iyy="0.0000001" iyz="0.0"
            izz="0.0000001"/>
      </inertial>
    </link>

    <joint name="base_arm_joint${child1}" type="fixed">
      <parent link="base_link"/>
      <child link="rotor_arm${child1}"/>
      <origin rpy="0 0 ${pi/4}" xyz="0.09035 0.09035 0.0265"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="rotor_arm${child2}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.0000001" ixy="0.0" ixz="0.0"
            iyy="0.0000001" iyz="0.0"
            izz="0.0000001"/>
      </inertial>
    </link>
    <joint name="base_arm_joint${child2}" type="fixed">
      <parent link="base_link"/>
      <child link="rotor_arm${child2}"/>
      <origin rpy="0 0 ${3*pi/4}" xyz="-0.09035 0.09035 0.0265"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="rotor_arm${child3}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.0000001" ixy="0.0" ixz="0.0"
            iyy="0.0000001" iyz="0.0"
            izz="0.0000001"/>
      </inertial>
    </link>
    <joint name="base_arm_joint${child3}" type="fixed">
      <parent link="base_link"/>
      <child link="rotor_arm${child3}"/>
      <origin rpy="0 0 -${1/4*pi}" xyz="0.09035 -0.09035 0.0265"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="rotor_arm${child4}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.0000001" ixy="0.0" ixz="0.0"
            iyy="0.0000001" iyz="0.0"
            izz="0.0000001"/>
      </inertial>
    </link>
    <joint name="base_arm_joint${child4}" type="fixed">
      <parent link="base_link"/>
      <child link="rotor_arm${child4}"/>
      <origin rpy="0 0 -${3/4*pi}" xyz="-0.09035 -0.09035 0.0265"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="contact_point">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.0001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.0001" iyz="0.0"
            izz="0.0001"/>
      </inertial>
    </link>
    <joint name="cp_base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="contact_point"/>
      <origin rpy="0 0 0" xyz="0.26 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <xacro:friction self="base_link"/>
  </xacro:macro>

  <xacro:macro name="bee_thrust_link" params="self rotor_direction">
    ## link
    #### rotor parent link (virtual) ####
    <link name="gimbal_link${self}">
      <inertial>
        <origin xyz="0.01840184 0.00000854 -0.02830914" rpy="0 0 0" />
        <mass value="0.08544" />
        <inertia
            ixx="0.00009180229"
            ixy="-0.00000000453"
            ixz="-0.00000087151"
            iyy="0.00007733826"
            iyz="-0.00000000467"
            izz="0.00014400614" />
      </inertial>
      <collision>
        <origin xyz="0.0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="0.033"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://bee/urdf/mesh/rotor_module.dae"/>
        </geometry>
      </visual>
    </link>
    <xacro:damping_factor link="gimbal_link${self}"/>

    ## rotor parent link (virtual)
    <gazebo reference="rotor_parent${self}">
      <visual><material><ambient>${propeller_rgba}</ambient><diffuse>${propeller_rgba}</diffuse></material></visual>
    </gazebo>
    <link name="rotor_parent${self}">
      <visual>
        <geometry><mesh filename="package://bee/urdf/mesh/propeller.stl"/></geometry>
        <material name="propeller_color"/>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.000001" ixy="0.0" ixz="0.0"
            iyy="0.000001" iyz="0.0"
            izz="0.000001"/>
      </inertial>
    </link>

    ## thrust link (virtual)
    <link name="thrust${self}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia
            ixx="0.001" ixy="0.0" ixz="0.0"
            iyy="0.001" iyz="0.0"
            izz="0.001"/>
      </inertial>
    </link>
    <xacro:damping_factor link="thrust${self}"/>

    #### joints ####

    #### gimbal joints ####
    <joint name="gimbal${self}" type="revolute">
      <limit effort="6.6" lower="-4.5" upper="4.5" velocity="3.0"/>
      <parent link="rotor_arm${self}"/>
      <child link="gimbal_link${self}"/>
      <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="0.8" friction="0.0"/>
    </joint>

    <transmission name="joint_tran${self}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="gimbal${self}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="servo${self}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    #### rotor parent link joint (virtual) ####
    <joint name="rotor_parent_link_joint${self}" type="fixed">
      <parent link="gimbal_link${self}"/>
      <child link="rotor_parent${self}"/>
      <origin rpy="0 0 0" xyz="0.018 0.00 0.0"/>
      <axis xyz="0 0 ${rotor_direction}"/>
    </joint>

    #### rotor joint (virtual) ####
    <joint name="rotor${self}" type="continuous">
      <limit effort="100.0" lower="${min_force}" upper="${max_force}" velocity="0.5"/>
      <parent link="rotor_parent${self}"/>
      <child link="thrust${self}"/>
      <origin rpy="0 0 0" xyz="0 0 -0.04"/>
      <axis xyz="0 0 ${rotor_direction}"/>
    </joint>

    <transmission name="rotor_tran${self}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="rotor${self}">
        <hardwareInterface>RotorInterface</hardwareInterface>
      </joint>
      <actuator name="rotor_actuator${self}">
        <hardwareInterface>RotorInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

  </xacro:macro>

  <xacro:macro name="extra_module" params="name parent *origin *inertial visible:=0 model_url:=1 scale:=1">
    <joint name="${parent}2${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin" />
    </joint>
    <link name="${name}">
      <xacro:insert_block name="inertial" />
      <xacro:if value="${visible == 1}">
        <visual>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <geometry>
            <mesh filename="${model_url}" scale= "${scale} ${scale} ${scale}"/>
          </geometry>
        </visual>
      </xacro:if>
    </link>
  </xacro:macro>

    <!-- livox mid360 -->
  <xacro:extra_module name = "lidar_imu" parent = "base_link" visible = "0" > <!-- should be IMU frame -->
    <origin xyz="${0.011} ${0.02329} ${0.072 + 0.047 - 0.04412}" rpy="0 0 0"/> <!-- TODO: the true pos -->
    <inertial>
      <mass value = "00" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.0" ixy="0.0" ixz="0.0"
          iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
  </xacro:extra_module>

</robot>
