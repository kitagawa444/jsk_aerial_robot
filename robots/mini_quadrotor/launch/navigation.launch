<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="robot_ns" default="quadrotor" />
  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">
    ## git clone -b lunar-devel https://github.com/ros-perception/pointcloud_to_laserscan.git
    <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="pointcloud_to_laserscan">
      <remap from="cloud_in" to="livox/lidar_orig"/>
      <remap from="scan" to="livox/scan"/>
      <rosparam>
        transform_tolerance: 0.01
        min_height: -0.1
        max_height: 0.1

        angle_min: -3.1415 
        angle_max: 3.1415
        angle_increment: 0.0087 # M_PI/360.0
        scan_time: 0.1
        range_min: 0.0
        range_max: 40.0
        use_inf: true
        inf_epsilon: 1.0

        # Concurrency level, affects number of pointclouds queued for processing and number of threads used
        # 0 : Detect number of cores
        # 1 : Single threaded
        # 2->inf : Parallelism level
        concurrency_level: 1
      </rosparam>
      <param name="target_frame" type="string" value="$(arg robot_ns)/lidar_imu"/>

    </node>

    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
      <rosparam file="$(find mini_quadrotor)/param/navigation/costmap_common_params.yaml" command="load" ns="global_costmap" />
      <rosparam file="$(find mini_quadrotor)/param/navigation/costmap_common_params.yaml" command="load" ns="local_costmap" />
      <rosparam file="$(find mini_quadrotor)/param/navigation/local_costmap_params.yaml" command="load" />
      <rosparam file="$(find mini_quadrotor)/param/navigation/global_costmap_params.yaml" command="load" />
      <rosparam file="$(find mini_quadrotor)/param/navigation/base_local_planner_default_params.yaml" command="load" />
      <rosparam file="$(find mini_quadrotor)/param/navigation/move_base_params.yaml" command="load" />
      <param name="global_costmap/obstacle_layer/scan/topic" value="livox/scan" />
      <param name="global_costmap/obstacle_layer/scan/min_obstacle_height" value="-0.1"  />
      <param name="local_costmap/obstacle_layer/scan/topic" value="livox/scan"  />
      <param name="local_costmap/obstacle_layer/scan/min_obstacle_height" value="-0.1"  />
      <param name="local_costmap/robot_base_frame" value="$(arg robot_ns)/root"  />
      <param name="global_costmap/robot_base_frame" value="$(arg robot_ns)/root"  />
      <remap from ="cmd_vel" to="cmd_vel"/>
    </node>

    <node pkg="mini_quadrotor" type="cmd_vel_to_flight_nav.py" name="cmd_vel_to_flight_nav" output="screen"/>

  </group>
</launch>
